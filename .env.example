# Copy to .env and fill in. Never commit .env.
# Warehouse to read from / write back to (SQLAlchemy URL)
WAREHOUSE_URL=postgresql+psycopg://crm:crm@localhost:5432/warehouse
# Where sync state (base snapshots, watermarks, dead letters) lives
STATE_URL=postgresql+psycopg://crm:crm@localhost:5432/warehouse
# Real HubSpot: https://api.hubapi.com   Fake server: http://localhost:8090
HUBSPOT_BASE_URL=http://localhost:8090
# HubSpot private app access token (scopes: crm.objects.contacts/companies/deals read+write)
HUBSPOT_ACCESS_TOKEN=replace-me
